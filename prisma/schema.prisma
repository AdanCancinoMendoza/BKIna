// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organizacion {
  id           String   @id @default(uuid())
  nombre       String
  rfc          String?
  direccion    String?
  pais         String?
  estado       String?
  municipio    String?
  codigoPostal String?
  telefono     String?
  whatsapp     String?
  email        String?
  logo         String?
  regimenFiscal String?
  ivaActivo    Boolean  @default(true)
  porcentajeIva Decimal @default(16.00) @db.Decimal(5, 2)
  temaId       String?  @default("gold")
  colorPrimario String? @default("#D8A814")
  colorSecundario String? @default("#050505")
  fondoPersonalizado String? @default("#F7F7F7")
  tipografia   String?  @default("sans")
  configuracionTema Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  perfiles      Perfil[]
  sucursales    Sucursal[]
  usuarios      Usuario[]
  familias      Familia[]
  articulos     Articulo[]
  clientes      Cliente[]
  ventas        Venta[]
  promociones   Promocion[]
  campanas      Campana[]
  suscripciones Suscripcion[]
  unidadesMedida UnidadMedida[]
  eventosCalendario EventoCalendario[]
  cortesCaja    CorteCaja[]
  proveedores   Proveedor[]
}

model Suscripcion {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  plan           String       // "Básico", "Pro", "Enterprise"
  estado         String       // "Activa", "Cancelada", "Pendiente"
  fechaInicio    DateTime
  fechaFin       DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Sucursal {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String
  direccion      String?
  telefono       String?
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  terminales       Terminal[]
  usuarios         Usuario[]
  inventarios      Inventario[]
  movimientosStock MovimientoStock[]
  ventas           Venta[]

  @@index([organizacionId])
}

model Terminal {
  id                 String   @id @default(uuid())
  sucursalId         String
  sucursal           Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  nombre             String   // Ej. "Caja 01", "Caja 02"
  estado             String   @default("Cerrada") // "Abierta", "Cerrada"
  perfilesPermitidos Json?    // Perfiles autorizados para operar esta terminal
  usuarioEncargadoId String?  // ID de usuario cajero asignado
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ventas Venta[]

  @@index([sucursalId])
}

model Perfil {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String       // Ej. "Administrador", "Cajero", "Supervisor", "Vendedor"
  descripcion    String?
  esAdmin        Boolean      @default(false)
  activo         Boolean      @default(true)
  permisos       Json         // Configuración de módulos y permisos del Punto de Venta (POS)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  usuarios       Usuario[]

  @@unique([organizacionId, nombre])
}

model Usuario {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  sucursalId     String?
  sucursal       Sucursal?    @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  perfilId       String?
  perfil         Perfil?      @relation(fields: [perfilId], references: [id], onDelete: SetNull)
  nombre         String
  email          String       @unique
  telefono       String?
  password       String
  pin            String?      // Código de acceso rápido (PIN de 4-6 dígitos)
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ventas           Venta[]
  movimientosStock MovimientoStock[]

  @@index([organizacionId, activo])
  @@index([sucursalId])
}

model Familia {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String
  descripcion    String?
  createdAt      DateTime     @default(now())

  subfamilias Subfamilia[]
  articulos   Articulo[]
}

model Subfamilia {
  id          String   @id @default(uuid())
  familiaId   String
  familia     Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now())

  articulos Articulo[]
}

model Articulo {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  familiaId      String?
  familia        Familia?     @relation(fields: [familiaId], references: [id], onDelete: SetNull)
  subfamiliaId   String?
  subfamilia     Subfamilia?  @relation(fields: [subfamiliaId], references: [id], onDelete: SetNull)
  proveedorId    String?
  proveedor      Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  codigo         String       // SKU / Código de barras
  nombre         String
  descripcion    String?
  precioCompra   Decimal      @db.Decimal(10, 2)
  precioVenta    Decimal      @db.Decimal(10, 2)
  unidad         String       @default("Pieza") // "Pieza", "Kg", "Ltr", etc.
  necesitaBascula Boolean     @default(false)   // ¿Requiere pesaje en báscula / balanza para imprimir etiqueta?
  stockIlimitado Boolean      @default(false)   // ¿Permite ventas rápidas sin control de inventario / existencias ilimitadas?
  imagen         String?
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventarios      Inventario[]
  detallesVenta    DetalleVenta[]
  movimientosStock MovimientoStock[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId, activo])
  @@index([familiaId])
  @@index([subfamiliaId])
  @@index([proveedorId])
}

model UnidadMedida {
  id              String        @id @default(uuid())
  organizacionId  String?
  organizacion    Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre          String
  abreviatura     String
  descripcion     String?
  tipo            String        @default("conteo") // "conteo", "peso", "volumen", "longitud", "empaque"
  necesitaBascula Boolean       @default(false)    // ¿Requiere pesaje en báscula para imprimir etiqueta?
  activo          Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@unique([organizacionId, nombre])
}

model Inventario {
  id          String   @id @default(uuid())
  sucursalId  String
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  articuloId  String
  articulo    Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  stockActual Int      @default(0)
  stockMinimo Int      @default(5)
  stockMaximo Int      @default(100)
  updatedAt   DateTime @updatedAt

  @@unique([sucursalId, articuloId])
  @@index([articuloId])
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
}

model MovimientoStock {
  id         String         @id @default(uuid())
  articuloId String
  articulo   Articulo       @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  sucursalId String
  sucursal   Sucursal       @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  usuarioId  String?
  usuario    Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipo       TipoMovimiento
  cantidad   Int
  motivo     String?
  createdAt  DateTime       @default(now())

  @@index([sucursalId, createdAt(sort: Desc)])
  @@index([articuloId, createdAt(sort: Desc)])
}

model Cliente {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String
  telefono       String?
  email          String?
  rfc            String?
  localidad      String?
  puntos         Int          @default(0)
  saldo          Decimal      @default(0.00) @db.Decimal(10, 2)
  descuento      Decimal      @default(0.00) @db.Decimal(5, 2) // % de descuento preferencial (ej. 5.00 = 5%)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ventas Venta[]

  @@index([organizacionId, createdAt(sort: Desc)])
  @@index([telefono])
}

enum EstadoVenta {
  PAGADO
  DEVUELTO
  CANCELADO
}

model Venta {
  id             String       @id @default(uuid())
  folio          String       // ej. "T-000128"
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  sucursalId     String
  sucursal       Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  terminalId     String?
  terminal       Terminal?    @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  clienteId      String?
  cliente        Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  usuarioId      String?      // Vendedor
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  subtotal   Decimal     @db.Decimal(10, 2)
  descuento  Decimal     @default(0.00) @db.Decimal(10, 2)
  impuesto   Decimal     @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  metodoPago String      // "Efectivo", "Tarjeta", "Transferencia"
  estado     EstadoVenta @default(PAGADO)
  createdAt  DateTime    @default(now())

  detalles DetalleVenta[]

  @@index([organizacionId, createdAt(sort: Desc)])
  @@index([sucursalId, createdAt(sort: Desc)])
  @@index([terminalId, estado])
  @@index([clienteId])
  @@index([usuarioId])
}

model DetalleVenta {
  id             String   @id @default(uuid())
  ventaId        String
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  articuloId     String
  articulo       Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)

  @@index([ventaId])
  @@index([articuloId])
}

model Promocion {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String
  descripcion    String?
  tipo           String       // "PORCENTAJE", "MONTO_FIJO", "2X1"
  descuento      Decimal      @db.Decimal(10, 2)
  fechaInicio    DateTime
  fechaFin       DateTime
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model Campana {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String
  canal          String       // "SMS", "WHATSAPP", "EMAIL"
  mensaje        String
  estado         String       @default("BORRADOR") // "BORRADOR", "ENVIADA", "PROGRAMADA"
  fechaEnvio     DateTime?
  totalDestinatarios Int      @default(0)
  enviados       Int          @default(0)
  createdAt      DateTime     @default(now())
}

model EventoCalendario {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tipo           String       @default("RECORDATORIO") // "PEDIDO", "RECORDATORIO", "NOTA"
  titulo         String
  descripcion    String?
  fecha          String       // "YYYY-MM-DD"
  hora           String?      // "HH:mm"
  monto          Decimal?     @db.Decimal(10, 2)
  clienteNombre  String?
  telefono       String?
  enviarWhatsapp Boolean      @default(false)
  estado         String       @default("PENDIENTE") // "PENDIENTE", "EN_PROCESO", "COMPLETADO", "CANCELADO"
  prioridad      String       @default("MEDIA") // "BAJA", "MEDIA", "ALTA", "URGENTE"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CorteCaja {
  id                  String       @id @default(uuid())
  organizacionId      String
  organizacion        Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  sucursalId          String?
  terminalId          String?
  usuarioId           String?
  nombreUsuario       String?
  nombreTerminal      String?
  tipo                String       @default("PARCIAL") // "PARCIAL", "FINAL", "X", "Z"
  fondoInicial        Decimal      @default(0.00) @db.Decimal(12, 2)
  ventasEfectivo      Decimal      @default(0.00) @db.Decimal(12, 2)
  ventasTarjeta       Decimal      @default(0.00) @db.Decimal(12, 2)
  ventasTransferencia Decimal      @default(0.00) @db.Decimal(12, 2)
  totalVentas         Decimal      @default(0.00) @db.Decimal(12, 2)
  entradasEfectivo    Decimal      @default(0.00) @db.Decimal(12, 2)
  retirosEfectivo     Decimal      @default(0.00) @db.Decimal(12, 2)
  efectivoEsperado    Decimal      @default(0.00) @db.Decimal(12, 2)
  efectivoContado     Decimal      @default(0.00) @db.Decimal(12, 2)
  diferencia          Decimal      @default(0.00) @db.Decimal(12, 2)
  totalTickets        Int          @default(0)
  notas               String?
  fecha               DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizacionId, fecha])
}

model Proveedor {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  nombre         String       // Razón Social o Nombre Comercial
  contacto       String?      // Nombre del representante o asesor comercial
  rfc            String?
  telefono       String?
  whatsapp       String?
  email          String?
  direccion      String?
  ciudad         String?
  estado         String?
  codigoPostal   String?
  categoria      String?      // Giro comercial: "Alimentos y Bebidas", "Abarrotes", "Lácteos", "Materia Prima", "Limpieza", "Empaques", "Servicios", etc.
  diasCredito    Int          @default(0) // Días de crédito: 0 = Contado, 15, 30, etc.
  limiteCredito  Decimal      @default(0.00) @db.Decimal(10, 2)
  saldoPendiente Decimal      @default(0.00) @db.Decimal(10, 2)
  banco          String?      // BBVA, Banorte, Santander, etc.
  cuentaBancaria String?      // Número de cuenta o tarjeta
  clabe          String?      // CLABE interbancaria (18 dígitos)
  notas          String?      // Días de entrega, horarios, condiciones
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  articulos      Articulo[]

  @@index([organizacionId, activo])
  @@index([organizacionId, createdAt(sort: Desc)])
  @@index([telefono])
  @@index([nombre])
}

